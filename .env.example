# Optional fixed date for demonstrations only. Leave unset for the real UTC date.
# NEXT_PUBLIC_HOMECARE_DEMO_DATE=2026-11-07
# Local server-only database path (never a real client database in Git).
# HOMECARE_DB_PATH=F:/homecare/dashboardandhourstracker/data/homecare.sqlite

# Google sign-in (server-only; put real values in .env.local, never Git).
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Exact comma-separated staff Google emails. Empty means nobody is allowed.
AUTH_ALLOWED_EMAILS=
